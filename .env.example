# Copy this file to .env and fill in your values. NEVER commit .env.

GROQ_API_KEY=GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Only for private repos or higher GitHub rate limits.
GITHUB_TOKEN=

QDRANT_PATH=data/qdrant
QDRANT_URL=QDRANT_URL
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

WORKSPACE_DIR=workspaces
MAX_REPAIR_ATTEMPTS=3
COMMAND_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048

GITHUB_API_URL=https://api.github.com

GITHUB_TIMEOUT_SECONDS=15
CLONE_TIMEOUT_SECONDS=180
MAX_REPO_SIZE_MB=200

MAX_FILE_KB=256
MAX_SCAN_FILES=3000
CHUNK_MAX_LINES=60
CHUNK_OVERLAP_LINES=10

# "hashing" is a tiny offline embedder for CI and tests. Use sentence-transformers for real work.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=512
DEFAULT_TOP_K=8

RETRIEVAL_CANDIDATES=30
RRF_K=60
# "overlap" is a tiny offline reranker for CI and tests. "none" turns reranking off.
RERANKER_BACKEND=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

MAX_FILES_CHANGED=10
MAX_PATCH_KB=200
MAX_EDIT_KB=128

MAX_TOOL_CALLS=80
TOOL_OUTPUT_MAX_CHARS=6000
READ_MAX_LINES=200

# Set to true after the models are downloaded once. Avoids network checks at load time.
MODELS_OFFLINE=True

MAX_EXPLORE_STEPS=6
EXPLORE_RESULT_CHARS=2500
MAX_PLAN_ATTEMPTS=2